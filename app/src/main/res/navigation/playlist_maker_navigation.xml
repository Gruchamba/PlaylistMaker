<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlist_maker_navigation"
    app:startDestination="@id/mediaLibraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="org.guru.playlistmaker.ui.search.fragment.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="org.guru.playlistmaker.ui.library.fragment.MediaLibraryFragment"
        android:label="fragment_media_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_createOrUpdatePlaylistFragment"
            app:destination="@id/createOrUpdatePlaylistFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_readPlaylistFragment"
            app:destination="@id/readPlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="org.guru.playlistmaker.ui.settings.fragment.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/playerFragment"
        android:name="org.guru.playlistmaker.ui.player.fragment.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" >
        <action
            android:id="@+id/action_playerFragment_to_createOrUpdatePlaylistFragment"
            app:destination="@id/createOrUpdatePlaylistFragment" />
    </fragment>
    <fragment
        android:id="@+id/createOrUpdatePlaylistFragment"
        android:name="org.guru.playlistmaker.ui.library.newPlaylist.fragment.CreateOrUpdatePlaylistFragment"
        android:label="fragment_create_or_update_playlist"
        tools:layout="@layout/fragment_create_or_update_playlist" />
    <fragment
        android:id="@+id/readPlaylistFragment"
        android:name="org.guru.playlistmaker.ui.library.readPlaylist.fragment.ReadPlaylistFragment"
        android:label="fragment_library_read_playlist"
        tools:layout="@layout/fragment_library_read_playlist" >
        <action
            android:id="@+id/action_readPlaylistFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_readPlaylistFragment_to_createOrUpdatePlaylistFragment"
            app:destination="@id/createOrUpdatePlaylistFragment" />
    </fragment>
</navigation>